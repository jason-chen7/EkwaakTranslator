# Copy to .env and fill in. Only ANTHROPIC_API_KEY is required for local Whisper.
# NOTE: put your REAL key in api/.env (gitignored), NOT here. This file is a
# committed template — keep it as a placeholder.
ANTHROPIC_API_KEY=sk-ant-...

# Translation model (see README for the cost/quality tradeoff)
CLAUDE_MODEL=claude-sonnet-4-6

# Transcription backend: local (free, slower) | openai (fast, needs key below)
WHISPER_BACKEND=local
WHISPER_MODEL=small
WHISPER_DEVICE=cpu
WHISPER_COMPUTE=int8

# Only needed if WHISPER_BACKEND=openai
# OPENAI_API_KEY=sk-...

# --- YouTube anti-bot ---
# YouTube blocks anonymous downloads. Borrow your browser's YouTube login cookies.
# Set to the browser you're signed into YouTube on: firefox|chrome|edge|brave|chromium
# (Or use YTDLP_COOKIES_FILE=path\to\cookies.txt instead.)
# YTDLP_COOKIES_FROM_BROWSER=firefox

# --- Cost controls (only NEW videos count; cached videos are always free) ---
# Global daily cap on new translations (UTC reset). ~15 keeps you under ~$2/day.
DAILY_NEW_VIDEO_LIMIT=15
# Per-visitor rate limit: max RATE_LIMIT_PER_WINDOW new videos per RATE_LIMIT_WINDOW_MIN minutes.
RATE_LIMIT_WINDOW_MIN=20
RATE_LIMIT_PER_WINDOW=2
